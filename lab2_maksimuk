console.log("\n=== Демонстрация работы с разными устройствами ===");

function useDevice(device: Device): void {
    console.log(`Device type: ${device.getType()}`);
    const poweredOn = device.powerOn();
    console.log(`Powered on: ${poweredOn}\n`);
}

useDevice(new Phone(50, 6.5));
useDevice(new Laptop(30, 14));

function testDeviceLogging(device: Device & Logger): void {
    console.log(`\nTesting ${device.getType()} logging:`);
    device.log("Log message 1");
    device.log("Log message 2");
}

const phoneForTesting = new Phone(80, 6.5);
const laptopForTesting = new Laptop(70, 15.6);

testDeviceLogging(phoneForTesting);
testDeviceLogging(laptopForTesting);
